{
  "expo": {
    "name": "Marketplace Helper",
    "slug": "mh-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/marketplace-helper-ico.png",
    "scheme": "mhmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/marketplace-helper-ico.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/marketplace-helper-ico.png",
        "backgroundImage": "./assets/images/marketplace-helper-ico.png",
        "monochromeImage": "./assets/images/marketplace-helper-ico.png"
      },
      "package": "com.guilermes.marketplacehelper",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/marketplace-helper-ico.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita o acesso à câmera para medir as caixas dos produtos."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a1f3ddb2-3f4e-4c9d-b566-11ba25c4e73d"
      }
    },
    "owner": "guilermes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a1f3ddb2-3f4e-4c9d-b566-11ba25c4e73d"
    }
  }
}
